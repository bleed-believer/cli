{
    "name": "@bleed-believer/cli",
    "type": "module",
    "version": "2.0.0",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build:cls": "rm -rf dist",
        "build:swc": "swc ./src -d ./dist --strip-leading-paths",
        "build": "node --run build:cls && node --run build:swc"
    },
    "dependencies": {
        "@swc/core": "^1.16.18",
        "json5": "^2.2.3"
    },
    "allowScripts": {
        "@swc/core@1.16.18": true
    },
    "devDependencies": {
        "@swc/cli": "^0.8.1",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2"
    }
}
